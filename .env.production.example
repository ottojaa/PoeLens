# Production environment for the home server. Copy to /opt/poelens/.env.production (chmod 600) and fill in the
# password; the README's "Production" section has the steps. docker-compose.prod.yml feeds this file to the backend and
# reads the database credentials from it for the database container; scripts read BACKUP_DIR from it.
# Keep every value free of spaces and quotes: Docker passes them through as they are.

# ─── Database ────────────────────────────────────────────────────────────────
# The postgres container creates this role and database on its first start. Changing them afterwards does not
# rename anything inside an existing volume.
POSTGRES_USER=poelens
POSTGRES_DB=poelens
# Generate with: openssl rand -hex 24   (hex keeps it safe inside the URL below)
POSTGRES_PASSWORD=CHANGE_ME
# Must repeat the three values above; the host is the compose service name.
DATABASE_URL=postgres://poelens:CHANGE_ME@postgres:5432/poelens

# Optional: how much of the host the database container is tuned for. Read only when the data directory is first
# created. Defaults: 2GB and 2.
# TS_TUNE_MEMORY=2GB
# TS_TUNE_NUM_CPUS=2

# ─── API ─────────────────────────────────────────────────────────────────────
PORT=3100
HOST=0.0.0.0
# Origins allowed to call the API (comma-separated): the web app, and the desktop app (which loads it).
CORS_ORIGIN=https://poelens.com

# ─── Price collector ─────────────────────────────────────────────────────────
# History only exists from the moment this runs, so production turns it on. Off by default everywhere else.
COLLECTOR_ENABLED=true
# Sent in the User-Agent of every poe.ninja request so its owners can reach us.
COLLECTOR_CONTACT=https://github.com/ottojaa/PoeLens
# Leagues to collect, comma-separated names. Empty: the current challenge league and its hardcore version.
COLLECTOR_LEAGUES=

# ─── Backups (read by scripts/backup.sh and scripts/deploy.sh, ignored by the API) ─
# Where the dumps go. A dump on the same disk as the database volume does not survive that disk dying: the NAS that
# reverie already mounts is the better home. Create the directory first.
BACKUP_DIR=/mnt/nas/poelens/backups
