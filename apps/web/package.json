{
    "name": "@poelens/web",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "main": "dist-electron/main.mjs",
    "build": {
        "appId": "dev.poelens.app",
        "productName": "PoeLens",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist-electron/**/*"
        ],
        "mac": {
            "category": "public.app-category.games",
            "target": [
                "dmg",
                "zip"
            ]
        },
        "win": {
            "target": [
                "nsis",
                "portable"
            ]
        },
        "linux": {
            "target": [
                "AppImage"
            ],
            "category": "Game"
        }
    },
    "devDependencies": {
        "@fontsource/inter": "^5.2.8",
        "@poelens/shared": "workspace:*",
        "@tailwindcss/vite": "^4.1.18",
        "@tanstack/react-query": "^5.90.19",
        "@tanstack/react-router": "^1.154.8",
        "@tanstack/router-plugin": "^1.154.8",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^4.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "electron": "^40.0.0",
        "electron-builder": "^26.4.0",
        "lucide-react": "^0.562.0",
        "radix-ui": "^1.4.3",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwind-merge": "^3.4.0",
        "tailwindcss": "^4.1.18",
        "tw-animate-css": "^1.4.0",
        "typescript": "~5.9.2",
        "vite": "^7.0.0",
        "wait-on": "^9.0.3"
    },
    "description": "PoeLens web app and desktop shell"
}
