{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "@poelens/backend",
    "projectType": "application",
    "sourceRoot": "apps/backend/src",
    "tags": [],
    "targets": {
        "lint": {
            "executor": "@nx/eslint:lint",
            "outputs": ["{options.outputFile}"],
            "options": {
                "lintFilePatterns": ["apps/backend/**/*.ts"]
            }
        },
        "build": {
            "executor": "@nx/esbuild:esbuild",
            "outputs": ["{options.outputPath}"],
            "defaultConfiguration": "production",
            "options": {
                "platform": "node",
                "outputPath": "apps/backend/dist",
                "format": ["cjs"],
                "bundle": false,
                "main": "apps/backend/src/main.ts",
                "additionalEntryPoints": [
                    "apps/backend/src/db/migrate.ts",
                    "apps/backend/src/collector/collect.ts",
                    "apps/backend/src/collector/reparse.ts",
                    "apps/backend/src/services/auth/bootstrap-admin.ts"
                ],
                "tsConfig": "apps/backend/tsconfig.app.json",
                "skipTypeCheck": true,
                "esbuildOptions": {
                    "sourcemap": true,
                    "outExtension": {
                        ".js": ".js"
                    }
                }
            },
            "configurations": {
                "development": {},
                "production": {
                    "esbuildOptions": {
                        "sourcemap": false,
                        "outExtension": {
                            ".js": ".js"
                        }
                    }
                }
            }
        },
        "typecheck": {
            "inputs": [
                "default",
                "^production",
                {
                    "externalDependencies": ["typescript"]
                }
            ],
            "options": {
                "command": "tsc --build --emitDeclarationOnly && tsc -p tsconfig.spec.json"
            }
        },
        "serve": {
            "continuous": true,
            "executor": "@nx/js:node",
            "defaultConfiguration": "development",
            "dependsOn": ["build"],
            "options": {
                "buildTarget": "@poelens/backend:build",
                "runBuildTargetDependencies": false
            },
            "configurations": {
                "development": {
                    "buildTarget": "@poelens/backend:build:development"
                },
                "production": {
                    "buildTarget": "@poelens/backend:build:production"
                }
            }
        },
        "test": { "dependsOn": ["^build", "build"] },
        "migrate": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npx tsx apps/backend/src/db/migrate.ts"
            }
        },
        "migrate:down": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npx tsx apps/backend/src/db/migrate.ts down"
            }
        },
        "collect": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npx tsx apps/backend/src/collector/collect.ts"
            }
        },
        "bootstrap-admin": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npx tsx apps/backend/src/services/auth/bootstrap-admin.ts"
            }
        },
        "reparse": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npx tsx apps/backend/src/collector/reparse.ts"
            }
        }
    }
}
