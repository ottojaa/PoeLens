# Copy to .env for local development: cp .env.example .env
# Every value below is also the default outside production, so a checkout with no .env still boots.
# Ports are offset from reverie's defaults so both stacks can run side by side.

# Server
PORT=3100
HOST=0.0.0.0
NODE_ENV=development

# Database (docker compose up -d postgres): TimescaleDB on Postgres 17. Required in production.
DATABASE_URL=postgres://poelens:poelens@localhost:5433/poelens

# Origins allowed to call the API (comma-separated). The web dev server runs on 4300.
CORS_ORIGIN=http://localhost:4300

# Web app (Vite): where the browser reaches the API. Dev builds default to http://localhost:3100. A production
# build refuses to run without it; set it empty for same-origin.
# VITE_API_URL=http://localhost:3100
