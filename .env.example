# Copy to .env for local development: cp .env.example .env
# Every value below is also the default outside production, so a checkout with no .env still boots.
# Ports are offset from reverie's defaults so both stacks can run side by side.

# Server
PORT=3100
HOST=0.0.0.0

# Database (docker compose up -d postgres): TimescaleDB on Postgres 17. Required in production.
DATABASE_URL=postgres://poelens:poelens@localhost:5433/poelens

# Origins allowed to call the API (comma-separated). The web dev server runs on 4300.
CORS_ORIGIN=http://localhost:4300

# Price collector: polls poe.ninja about every 15 minutes. Leave off for development; set true only in production.
# Manual cycle: nx run @poelens/backend:collect
# COLLECTOR_ENABLED=false
# Who a data source can contact about our requests (goes into the User-Agent).
# COLLECTOR_CONTACT=https://github.com/ottojaa/PoeLens
# League names to collect, comma-separated. Empty: the current challenge league and its hardcore version.
# COLLECTOR_LEAGUES=

# Web app (Vite): where the browser reaches the API. Dev builds default to http://localhost:3100. A production
# build refuses to run without it; set it empty for same-origin.
# VITE_API_URL=http://localhost:3100

# Accounts: signs the 15-minute access tokens. Only needed in production, where it is required (at least 32 random
# characters, e.g. openssl rand -hex 32); development and tests use a built-in value.
# JWT_SECRET=
